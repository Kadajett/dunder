{
	"name": "dunder",
	"productName": "Dunder",
	"version": "0.1.0",
	"private": true,
	"description": "Dunder: a 3D office where your AI coding agents work, backed by herdr",
	"homepage": "https://dunder.yougotserved.dev",
	"author": "Jeremy Stover <jeremy.ryan.stover@gmail.com>",
	"desktopName": "dunder.desktop",
	"main": "out/main/index.js",
	"scripts": {
		"dev": "electron-vite dev",
		"build": "electron-vite build",
		"start": "electron-vite preview",
		"office": "electron-vite build && node src/cli/office-run.mts",
		"typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p packages/installer --noEmit && tsc -p site",
		"lint": "biome check .",
		"format": "biome format --write .",
		"test": "vitest run --project unit",
		"test:contract": "vitest run --project contract",
		"check": "npm run typecheck && npm run lint && npm run test",
		"dist": "electron-vite build && electron-builder --linux --x64 --publish never",
		"icon": "node scripts/icon/generate-icon.mts",
		"installer:build": "tsc -p packages/installer/tsconfig.build.json",
		"site:build": "npm --prefix site ci --no-audit --no-fund && npm --prefix site run build",
		"site:deploy": "npm --prefix site ci --no-audit --no-fund && npm --prefix site run deploy",
		"release:bump": "node scripts/release/bump.mts",
		"scene:shot": "node scripts/scene-shot/shot.mts",
		"scene:profile": "vite --config scripts/scene-shot/vite.config.ts --port 5179 --strictPort --logLevel info"
	},
	"dependencies": {
		"@excalidraw/excalidraw": "0.18.1",
		"fractional-indexing": "3.2.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@fontsource/inter": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@react-three/drei": "^10.7.9",
		"@react-three/fiber": "^9.8.1",
		"@types/node": "^22.20.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/three": "^0.186.0",
		"@vitejs/plugin-react": "^5.2.0",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/addon-webgl": "^0.19.0",
		"@xterm/headless": "^6.0.0",
		"@xterm/xterm": "^6.0.0",
		"electron": "^44.5.1",
		"electron-builder": "^26.15.3",
		"electron-vite": "^5.0.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"three": "^0.186.1",
		"troika-three-text": "^0.52.5",
		"typescript": "^5.9.3",
		"vite": "^7.3.7",
		"vitest": "^5.0.3",
		"zustand": "^5.0.15"
	}
}
